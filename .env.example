# Runtime switches -----------------------------------------------------------
# false = use the built-in keyword classifier (zero dependencies)
USE_REAL_ML=false
ML_SERVICE_URL=https://your-ml-service.onrender.com

# false = pretty-print event/finding/incident JSON to the server console
WRITE_TO_SUPABASE=false
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Policy (Boundary 4). shadow = log only, enforce = temp-block the IP after a
# high-confidence ML detection. Rule-based WAF blocks in both modes.
POLICY_MODE=shadow
AUTO_BLOCK_THRESHOLD=0.9
ALERT_THRESHOLD=0.6

# Sync rate limit (per IP + origin prefix)
RATE_LIMIT_MAX=50
RATE_LIMIT_WINDOW_MS=20000

# Origin registry -------------------------------------------------------------
# Optional JSON array. When set it replaces config/origins.json entirely.
# Shape: {"path_prefix":"/t/shop","origin_url":"https://example.com","origin_id":"uuid"}
# Also accepts the Boundary 4 shape: {"proxy_path":"/t/shop","origin_url":"..."}
# ORIGINS_JSON=[{"path_prefix":"/t/shop","origin_url":"https://example.com"}]

# Allow http:// and private/localhost origins (needed only for local victim apps)
ALLOW_PRIVATE_ORIGINS=false

# Internal blocked-event sink auth (recommended) and upstream fetch timeout
PROXY_SHARED_SECRET=
PROXY_TIMEOUT_MS=25000
